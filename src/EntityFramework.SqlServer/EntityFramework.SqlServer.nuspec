<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
	$CommonMetadataElements$
	<language>$NeutralLanguage$</language>
	<dependencies>
	  <group targetFramework="net10.0">
		<dependency id="EntityFramework" version="$Version$" exclude="Build,Analyzers" />
		<dependency id="System.Data.SqlClient" version="$SystemDataSqlClientVersion$" exclude="Build,Analyzers" />
	  </group>
	</dependencies>
  </metadata>
  <files>
	$CommonFileElements$
	<file src="../../artifacts/bin/EntityFramework.SqlServer/$Configuration$/net10.0/EntityFramework.SqlServer.dll" target="lib/net10.0/" />
	<file src="../../artifacts/bin/EntityFramework.SqlServer/$Configuration$/net10.0/EntityFramework.SqlServer.xml" target="lib/net10.0/" />
  </files>
</package>
