<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    $CommonMetadataElements$
    <language>$NeutralLanguage$</language>
    <readme>readme.md</readme>  
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="EntityFramework" version="$Version$" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Data.SqlClient" version="$MicrosoftDataSqlClientVersion$" exclude="Build,Analyzers" />
		    <!-- <dependency id="Microsoft.SqlServer.Types" version="$MicrosoftSqlServerTypesXplatVersion$" exclude="Build,Analyzers" /> -->
      </group>
    </dependencies>
  </metadata>
  <files>
    $CommonFileElements$
    <file src="../../artifacts/bin/Microsoft.EntityFramework.SqlServer/$Configuration$/net10.0/Microsoft.EntityFramework.SqlServer.dll" target="lib/net10.0/" />
    <file src="../../artifacts/bin/Microsoft.EntityFramework.SqlServer/$Configuration$/net10.0/Microsoft.EntityFramework.SqlServer.xml" target="lib/net10.0/" />
    <file src="../../artifacts/bin/Microsoft.EntityFramework.SqlServer/$Configuration$/net10.0/readme.md" target="/" />  
  </files>
</package>
